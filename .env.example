# Copy this file to .env.local and fill in your Supabase project values
# (Supabase dashboard → Project Settings → API).
# Use the PUBLISHABLE / anon key only. Never put the secret or service_role key here:
# every NEXT_PUBLIC_ (or VITE_) variable is bundled into the public website.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
